PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/watchtogether01
# Tests ke liye alag database (default: upar wale naam ke aage _test). Badalna ho tabhi:
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/watchtogether01_test

# Kam se kam 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-random-secret-here
FRONTEND_URL=http://localhost:5173

# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dhyan: ise badalne par purane chat messages padhe nahi ja sakte
MESSAGE_ENCRYPTION_KEY=64-hex-characters-here

# Email (OTP) ke liye Brevo
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=WatchTogether

MAX_VIDEO_SIZE_MB=2048
MAX_ROOM_MEMBERS=10
# AUTH_RATE_LIMIT=50

# Agar ffmpeg PATH mein nahi hai
# FFMPEG_PATH=
# FFPROBE_PATH=